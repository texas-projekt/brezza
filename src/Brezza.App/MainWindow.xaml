<Window x:Class="Brezza.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brezza" Height="760" Width="1120" MinHeight="420" MinWidth="640"
        Background="#FFFFFF" Loaded="OnLoaded" Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ChromeRow" Height="88" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="PageHost" Grid.Row="1" Panel.ZIndex="0" Background="#FFFFFF" />
        <TextBlock x:Name="StartupErrorPlaceholder" Grid.Row="1" Panel.ZIndex="0" Text="Brezza" FontSize="28"
                   FontWeight="SemiBold" Foreground="#A6AFB7" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Visibility="Collapsed" />
        <ContentControl x:Name="ChromeContainer" Grid.Row="0" Panel.ZIndex="100" />
    </Grid>
</Window>
